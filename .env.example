# Copy to .env and adjust as needed.

# ─── Elasticsearch (Docker) ──────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=ff_insights_events
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── LLM Backend Selection ───────────────────────────────────────────────
# "kiro" = local kiro-cli subprocess (custom hardened ReAct)
# "http" = Anthropic Messages API (LangGraph ReAct)
LLM_BACKEND=kiro

# ─── Kiro CLI (only needed if LLM_BACKEND=kiro) ─────────────────────────
KIRO_BINARY=kiro-cli
KIRO_MODEL=claude-opus-4.6

# ─── HTTP Backend (only needed if LLM_BACKEND=http) ─────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Saviynt AI Platform (only needed if LLM_BACKEND=http) ──────────────
LLM_HTTP_BASE_URL=https://iga-ai-dev.saviyntcloud.com/ECMv6
LLM_HTTP_AUTH_URL=https://iga-ai-dev.saviyntcloud.com/ECM/api/login
LLM_HTTP_USERNAME=
LLM_HTTP_PASSWORD=

# ─── Bounded Autonomy Caps ───────────────────────────────────────────────
REACT_MAX_ITERATIONS=7
REACT_MAX_PER_TOOL=4
REACT_WALL_CLOCK_SECONDS=300

# ─── Confidence Gate ─────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70

# ─── Evidence Verification ───────────────────────────────────────────────
EVIDENCE_VERIFY_MAX_RETRIES=2

# ─── Local storage paths ─────────────────────────────────────────────────
DATA_DIR=./data
LOG_DIR=./logs
